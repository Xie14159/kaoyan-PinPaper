# 生成产物 (generated artifacts)
试卷库/

# User ephemeral session data（错题/已做档案按用户与科目隔离，全部不提交）
# 注：早期把 wrong_notebook_default*.json 当模板种子提交，曾导致新用户 clone 后
# 自动复制出旧格式题号（三段式）错题，在当前题库中全部失配、虚增艾宾浩斯到期数。
user_data/wrong_notebook_*.json
user_data/*.test_bak*
user_wrong_notebook.json
user_data/full_backup_*/
user_data/data_checksum.json

# Secrets & Local Configs
.streamlit/secrets.toml
# 仅忽略根目录 config.toml；.streamlit/config.toml(主题)需随仓库部署
/config.toml

# 旧历史本地备份(勿提交,验证新仓库后可删)
.git_old/

# Runtime user state & secrets (not committed)
user_data/ai_config.json
user_data/ai_cost_log.json
user_data/ai_solutions.json
user_data/ai_solutions.json.bak
user_data/paper_config.json
user_data/pdf_index.json
user_data/pdf_lookup_cache.json

user_data/*.bak_*

# 运行时痕迹(DS终审11#15):哨兵/跨进程锁文件/损坏备份 均含敏感数据,不提交
user_data/.initialized
user_data/*.lock
user_data/*.corrupt.*
